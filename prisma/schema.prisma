generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gasto {
  id          Int       @id @default(autoincrement())
  monto       Float
  fecha       DateTime
  descripcion String
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
}

model Ingreso {
  id          Int      @id @default(autoincrement())
  monto       Float
  fecha       DateTime
  descripcion String
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}

model Categoria {
  id        Int     @id @default(autoincrement())
  nombre    String
  limite    Float
  color     String
  gastos    Gasto[]
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Usuario {
  id                 Int         @id @default(autoincrement())
  nombre             String
  email              String      @unique
  contrasenaHash     String
  creadoEn           DateTime    @default(now())
  categorias         Categoria[]
  ingresos           Ingreso[]
  presupuestoMensual Float       @default(0)
  cicloInicio        DateTime    @default(now())
  cicloDuracionDias  Int         @default(30)
}