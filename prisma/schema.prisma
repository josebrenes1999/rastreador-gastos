generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gasto {
  id          Int       @id @default(autoincrement())
  monto       Float
  fecha       String
  descripcion String
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String
  limite Float
  color  String
  gastos Gasto[]
}